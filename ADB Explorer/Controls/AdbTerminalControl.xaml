<UserControl
    x:Class="ADB_Explorer.Controls.AdbTerminalControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource DevicesListBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding Session.SessionTitle, ElementName=Root}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontFamily="Consolas"
                    FontSize="11"
                    Opacity="0.8"
                    Text="{Binding Session.StatusText, ElementName=Root}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,6,0"
                    Click="Interrupt_Click"
                    Content="Ctrl+C"
                    IsEnabled="{Binding Session.CanInterrupt, ElementName=Root}" />
                <Button
                    Margin="0,0,6,0"
                    Click="Find_Click"
                    Content="Find" />
                <Button Click="Clear_Click" Content="Clear" />
            </StackPanel>
        </Grid>
        <wv2:WebView2
            x:Name="TerminalWebView"
            Grid.Row="1"
            Margin="8,4,8,4"
            Focusable="True" />
    </Grid>
</UserControl>
